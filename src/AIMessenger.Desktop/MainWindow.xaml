<Window x:Class="AIMessenger.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Messenger PC"
        Width="1380"
        Height="900"
        MinWidth="1000"
        MinHeight="700"
        Background="#101217"
        Foreground="#F2F4F8">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171A21"
                CornerRadius="12"
                Margin="0,0,12,0"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="AI MESSENGER"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="4,2,4,16"/>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="PC agent runtime • #25"
                           Opacity="0.55"
                           Margin="4,16,4,0"/>
                <ListBox ItemsSource="{Binding Agents}"
                         SelectedItem="{Binding SelectedAgent}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="0,3"
                                    Background="#222632"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Provider}"
                                               FontSize="12"
                                               Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedAgent.Name}"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <Border Background="#293040"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#20242C"
                                Padding="12"
                                Margin="0,4"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.55"/>
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="70"
                         Padding="10"
                         Background="#171A21"
                         Foreground="#F2F4F8"
                         BorderBrush="#323744"
                         BorderThickness="1"/>

                <Button Grid.Column="1"
                        Content="SEND"
                        Command="{Binding SendCommand}"
                        Margin="10,0,0,0"
                        Background="#5B7CFF"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Grid>

        <Border Grid.Column="2"
                Background="#171A21"
                CornerRadius="12"
                Margin="12,0,0,0"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="AGENT CAPABILITIES"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Provider abstraction" Margin="0,4"/>
                    <TextBlock Text="Native tool-calling loop" Margin="0,4"/>
                    <TextBlock Text="FlaUI UI Automation" Margin="0,4"/>
                    <TextBlock Text="OpenClaw / Windows Hub bridge" Margin="0,4"/>
                    <TextBlock Text="SQLite workspace memory" Margin="0,4"/>
                    <TextBlock Text="Approvals + audit trail" Margin="0,4"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="TOOLS"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="calculator" Margin="0,3"/>
                    <TextBlock Text="list_windows" Margin="0,3"/>
                    <TextBlock Text="inspect_window" Margin="0,3"/>
                    <TextBlock Text="open_url • CONFIRM" Margin="0,3"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
