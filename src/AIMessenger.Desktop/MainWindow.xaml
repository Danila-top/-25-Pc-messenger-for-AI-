<Window x:Class="AIMessenger.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Messenger PC"
        Width="1450"
        Height="920"
        MinWidth="1100"
        MinHeight="720"
        Background="#101217"
        Foreground="#F2F4F8">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171A21"
                CornerRadius="12"
                Margin="0,0,12,0"
                Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="AI MESSENGER"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="4,2,4,16"/>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="PC agent runtime • #25"
                           Opacity="0.55"
                           Margin="4,16,4,0"/>

                <ListBox ItemsSource="{Binding Agents}"
                         SelectedItem="{Binding SelectedAgent}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    Margin="0,3"
                                    Background="#222632"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Provider}"
                                               FontSize="12"
                                               Opacity="0.6"/>
                                    <TextBlock Text="{Binding Model}"
                                               FontSize="11"
                                               Opacity="0.45"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedAgent.Name}"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <Border Background="#293040"
                            CornerRadius="8"
                            Padding="8,3"
                            Margin="10,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#20242C"
                                Padding="12"
                                Margin="0,4"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Opacity="0.55"/>
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="70"
                         Padding="10"
                         Background="#171A21"
                         Foreground="#F2F4F8"
                         BorderBrush="#323744"
                         BorderThickness="1"/>

                <Button Grid.Column="1"
                        Content="SEND"
                        Command="{Binding SendCommand}"
                        Margin="10,0,0,0"
                        Background="#5B7CFF"
                        Foreground="White"
                        FontWeight="Bold"/>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="#171A21"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AGENT CAPABILITIES"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Provider abstraction"
                                   Margin="0,4"/>
                        <TextBlock Text="Native tool-calling loop"
                                   Margin="0,4"/>
                        <TextBlock Text="FlaUI UI Automation"
                                   Margin="0,4"/>
                        <TextBlock Text="OpenClaw bridge"
                                   Margin="0,4"/>
                        <TextBlock Text="SQLite memory"
                                   Margin="0,4"/>
                        <TextBlock Text="Persistent approvals"
                                   Margin="0,4"/>

                        <Separator Margin="0,16"/>

                        <TextBlock Text="TOOLS"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="calculator"
                                   Margin="0,3"/>
                        <TextBlock Text="workspace_read"
                                   Margin="0,3"/>
                        <TextBlock Text="workspace_write • CONFIRM"
                                   Margin="0,3"/>
                        <TextBlock Text="list_windows"
                                   Margin="0,3"/>
                        <TextBlock Text="inspect_window"
                                   Margin="0,3"/>
                        <TextBlock Text="list_processes"
                                   Margin="0,3"/>
                        <TextBlock Text="open_url • CONFIRM"
                                   Margin="0,3"/>
                        <TextBlock Text="openclaw_agent • CONFIRM"
                                   Margin="0,3"/>
                    </StackPanel>
                </Border>

                <Border Background="#171A21"
                        CornerRadius="12"
                        Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="APPROVALS"
                                       FontSize="16"
                                       FontWeight="Bold"/>
                            <Button DockPanel.Dock="Right"
                                    Content="REFRESH"
                                    Command="{Binding RefreshApprovalsCommand}"
                                    Padding="8,3"/>
                        </DockPanel>

                        <TextBlock Text="Actions waiting for your decision"
                                   FontSize="12"
                                   Opacity="0.55"
                                   Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Approvals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#222632"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ToolName}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ArgumentsJson}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Opacity="0.7"
                                                       Margin="0,5,0,8"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="APPROVE"
                                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,8,0"
                                                        Padding="10,4"/>
                                                <Button Content="DENY"
                                                        Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="10,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
